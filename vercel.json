{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "redirects": [
    {
      "source": "/login",
      "destination": "/#/login",
      "permanent": false
    },
    {
      "source": "/worker/(.*)",
      "destination": "/#/worker/$1",
      "permanent": false
    },
    {
      "source": "/leader/(.*)",
      "destination": "/#/leader/$1",
      "permanent": false
    },
    {
      "source": "/admin/(.*)",
      "destination": "/#/admin/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
