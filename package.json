{
  "name": "workcrew",
  "version": "1.0.0",
  "description": "WorkCrew - Centralized Enterprise Workforce Management Platform",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "test": "npx tsx server/src/tests/acceptance.test.ts"
  },
  "keywords": [
    "workforce-management",
    "gps-attendance",
    "geofencing",
    "field-workers",
    "teams"
  ],
  "author": "WorkCrew Engineering",
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
